# =============================================================
#  Configuración del servidor Minecraft (copiar a .env)
#  scripts/install.sh crea .env automáticamente con una
#  contraseña RCON aleatoria. NO subas .env a git.
# =============================================================

# --- General ---
TZ=America/Mexico_City
# Versión de Minecraft. "LATEST" = última estable. Para un servidor
# en producción es mejor fijarla (ej. 1.21.4) y subirla a propósito.
MC_VERSION=LATEST
MOTD=§aServidor de SO y Redes §7- §e30+ jugadores
MAX_PLAYERS=40
DIFFICULTY=normal
# Rendimiento: distancias moderadas para soportar 30+ jugadores
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6

# --- Memoria ---
# Heap de Java. Con una VM de 12 GB: 8G. Con 24 GB: 12G.
MC_MEMORY=8G
# Límite duro del contenedor (heap + ~2 GB de margen para la JVM)
CONTAINER_MEM_LIMIT=10g

# --- Seguridad / acceso ---
# Dueño del servidor: único jugador con OP de vanilla.
SERVER_OWNER=TuNickDeMinecraft
# Jugadores iniciales en whitelist, separados por coma.
# Después se gestionan con scripts/whitelist.sh
WHITELIST=TuNickDeMinecraft
# Contraseña de RCON (consola remota). Solo accesible DENTRO de la
# red de Docker, nunca expuesta a internet. install.sh la genera.
RCON_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Backups ---
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
