# =============================================================
#  Configuración del servidor Minecraft (copiar a .env)
#  scripts/install.sh crea .env automáticamente con una
#  contraseña RCON aleatoria. NO subas .env a git.
# =============================================================

# --- Tipo de servidor ---
# Por defecto: Paper (recomendado, con plugins y roles).
# Para el servidor OFICIAL de Mojang (vanilla) descomenta la línea siguiente:
#COMPOSE_FILE=docker-compose.yml:docker-compose.vanilla.yml

# --- General ---
TZ=America/Mexico_City
# Versión de Minecraft del SERVIDOR.
# Con MC_VERSION_AUTO=true (recomendado) se usa automáticamente la versión
# más nueva que soportan TODOS los plugins, y MC_VERSION se ignora.
# Para fijar una versión concreta: MC_VERSION_AUTO=false y MC_VERSION=26.1.2
# Con Paper + ViaVersion/ViaBackwards los jugadores pueden entrar también
# con versiones del cliente oficial más nuevas o algo más antiguas.
MC_VERSION_AUTO=true
MC_VERSION=LATEST
MOTD=§aServidor de SO y Redes §7- §e30+ jugadores
MAX_PLAYERS=40
DIFFICULTY=normal
# Rendimiento: distancias moderadas para soportar 30+ jugadores
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6

# --- Memoria ---
# Heap de Java. Con una VM de 12 GB: 8G. Con 24 GB: 12G.
MC_MEMORY=8G
# Límite duro del contenedor. Java usa ~0,8 GB ADEMÁS del heap (medido):
# deja al menos 1 GB de diferencia. Máquina de 4 GB: 2304M / 3300m.
CONTAINER_MEM_LIMIT=10g

# --- Seguridad / acceso ---
# Dueño del servidor: único jugador con OP de vanilla.
SERVER_OWNER=TuNickDeMinecraft
# Jugadores iniciales en whitelist, separados por coma.
# Después se gestionan con scripts/whitelist.sh
WHITELIST=TuNickDeMinecraft
# Contraseña de RCON (consola remota). Solo accesible DENTRO de la
# red de Docker, nunca expuesta a internet. install.sh la genera.
RCON_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Backups ---
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
