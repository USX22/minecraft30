[Unit]
Description=Servidor Minecraft (Docker Compose)
Requires=docker.service
After=docker.service network-online.target minecraft-firewall.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@RUN_USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
