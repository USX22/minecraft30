# =============================================================
#  Configuración para RASPBERRY PI 4/5 (copiar a .env)
#  Es la misma plantilla que .env.example, con valores para la Pi.
#  scripts/install.sh la usa sola si detecta una Raspberry Pi.
#  Guía: docs/08-raspberry-pi.md. NO subas .env a git.
# =============================================================

# Activa el modo Raspberry Pi: límite de CPU + túnel de playit.gg
COMPOSE_FILE=docker-compose.yml:docker-compose.raspberrypi.yml
# Para además usar el servidor OFICIAL de Mojang (vanilla), usa esta línea:
#COMPOSE_FILE=docker-compose.yml:docker-compose.raspberrypi.yml:docker-compose.vanilla.yml

# --- Túnel de playit.gg (gratis, sin tarjeta) ---
# Clave del agente: https://playit.gg → Add Agent → Docker (ver docs/08 §4)
PLAYIT_SECRET_KEY=

# --- General ---
TZ=America/Mexico_City
MC_VERSION_AUTO=true
MC_VERSION=LATEST
MOTD=§aServidor de SO y Redes §7- §eRaspberry Pi
# Una Pi 4 aguanta ~10-15 jugadores a la vez (hasta ~20 con el mundo
# pregenerado). Más jugadores = lag para todos.
MAX_PLAYERS=20
DIFFICULTY=normal
# Distancias cortas: es lo que más ahorra CPU en la Pi
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4

# --- Memoria y CPU ---
# Pi de 8 GB: 4G de heap y 5g de límite (quedan ~3 GB para el sistema,
#             Pi-hole y lo demás que corra en la Pi).
# Pi de 4 GB: MC_MEMORY=2G y CONTAINER_MEM_LIMIT=2816m
MC_MEMORY=4G
CONTAINER_MEM_LIMIT=5g
# Núcleos que puede usar Minecraft (la Pi 4 tiene 4: se deja 1 libre)
CONTAINER_CPUS=3

# --- Seguridad / acceso ---
SERVER_OWNER=TuNickDeMinecraft
WHITELIST=TuNickDeMinecraft
RCON_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Backups ---
# Menos frecuentes que en Oracle para desgastar menos la microSD.
# Copia los backups FUERA de la Pi (docs/08 §7).
BACKUP_INTERVAL=12h
PRUNE_BACKUPS_DAYS=5
